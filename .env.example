# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: Stripe Payment Link — customer chooses amount at checkout
# Create in Stripe Dashboard: Product → Payment links → Add link. Then set the URL here.
# NEXT_PUBLIC_STRIPE_DONATION_LINK=https://buy.stripe.com/xxxxx
NEXT_PUBLIC_STRIPE_DONATION_LINK=

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Security hardening
# Comma-separated host allowlist for remote resume fetch (supports wildcard, e.g. *.supabase.co)
# ALLOWED_RESUME_FETCH_HOSTS=your-project.supabase.co,*.supabase.co
# Optional global API throttle (all wrapped API routes)
# GLOBAL_RATE_LIMIT_MAX=240
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Captcha (Cloudflare Turnstile-compatible verification endpoint)
# CAPTCHA_SECRET_KEY=your-captcha-secret
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Optional: enforce captcha secret presence in production
# CAPTCHA_REQUIRED=false

# External timeout tuning (milliseconds)
# AI_TIMEOUT_MS=20000
# AI_OLLAMA_TIMEOUT_MS=12000
# REMOTE_PDF_FETCH_TIMEOUT_MS=12000

# Sentry observability
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Ollama (local AI for resume analysis) - optional, defaults to localhost:11434
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
